#!/bin/bash
# gh-contributor - GitHub 贡献分析工具
# Author: Tech-Builder 🛸

set -e

COMMAND=$1
REPO=$2

show_help() {
    echo "gh-contributor - GitHub 贡献分析工具 🛸"
    echo ""
    echo "Usage:"
    echo "  gh-contributor rank <owner/repo>     # 查看贡献者排名"
    echo "  gh-contributor track <owner/repo>    # 追踪贡献进度"
    echo "  gh-contributor issues <owner/repo>   # 查找可贡献的 issues"
    echo "  gh-contributor help                  # 显示帮助"
    echo ""
    echo "Examples:"
    echo "  gh-contributor rank openclaw/openclaw"
    echo "  gh-contributor track openclaw/openclaw --user yourname"
}

if [ -z "$COMMAND" ] || [ "$COMMAND" == "help" ]; then
    show_help
    exit 0
fi

if [ -z "$REPO" ]; then
    echo "❌ Error: 请提供仓库地址 (owner/repo)"
    exit 1
fi

case $COMMAND in
    rank)
        echo "🚀 正在分析 $REPO 的贡献者排名..."
        gh api repos/$REPO/contributors --paginate 2>/dev/null | \
            jq -r '.[] | "\(.contributions)\t\(.login)"' | \
            sort -rn | \
            head -50 | \
            nl -v 1 | \
            awk '{printf "#%-3d %6s contributions  @%s\n", $1, $2, $3}'
        echo ""
        echo "🎯 进入 Top 50 需要约 $(gh api repos/$REPO/contributors --paginate 2>/dev/null | jq -r '.[49].contributions // 10')+ contributions"
        ;;
    
    track)
        USERNAME=${3:-$(gh api user -q .login)}
        echo "📊 追踪 @$USERNAME 在 $REPO 的贡献..."
        
        USER_CONTRIBS=$(gh api repos/$REPO/contributors --paginate 2>/dev/null | \
            jq -r ".[] | select(.login == \"$USERNAME\") | .contributions")
        
        if [ -z "$USER_CONTRIBS" ]; then
            echo "⚠️  @$USERNAME 还没有贡献记录"
            echo "💡 开始你的第一次贡献:"
            echo "   1. Fork 仓库: gh repo fork $REPO"
            echo "   2. Clone: git clone https://github.com/$(gh api user -q .login)/$(basename $REPO).git"
            echo "   3. 找 issue: gh-contributor issues $REPO"
        else
            RANK=$(gh api repos/$REPO/contributors --paginate 2>/dev/null | \
                jq -r '.[] | .login' | grep -n "^${USERNAME}$" | cut -d: -f1)
            echo "✅ 当前贡献: $USER_CONTRIBS"
            echo "🏆 当前排名: #$RANK"
            
            if [ "$RANK" -le 50 ]; then
                echo "🎉 恭喜！你已经是 Top 50 贡献者！"
            else
                NEEDED=$(gh api repos/$REPO/contributors --paginate 2>/dev/null | \
                    jq -r '.[49].contributions')
                echo "🎯 距离 Top 50 还需: $((NEEDED - USER_CONTRIBS + 1)) contributions"
            fi
        fi
        ;;
    
    issues)
        echo "🔍 正在查找 $REPO 的可贡献 issues..."
        echo ""
        
        # Good first issues
        echo "🟢 Good First Issues:"
        gh issue list --repo $REPO --state open --label "good first issue" --limit 5 2>/dev/null || echo "   暂无"
        
        echo ""
        echo "🐛 最新 Bug Issues:"
        gh issue list --repo $REPO --state open --label "bug" --limit 5 2>/dev/null || echo "   暂无"
        
        echo ""
        echo "✨ 最新 Feature Requests:"
        gh issue list --repo $REPO --state open --label "enhancement" --limit 5 2>/dev/null || echo "   暂无"
        ;;
    
    *)
        echo "❌ Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac
